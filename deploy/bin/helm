#!/usr/bin/env bash
# helm from a container, pointed at .workshop/kubeconfig. Its cache and config
# live in .workshop/helm so charts pulled once are not downloaded again.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_env.sh"
mkdir -p "$REPO/.workshop/helm"

exec docker run --rm "${tty_flags[@]}" ${net_flags[@]+"${net_flags[@]}"} "${repo_flags[@]}" \
  -e KUBECONFIG="$KUBECONFIG_IN" \
  -e HELM_CACHE_HOME=/workspace/.workshop/helm/cache \
  -e HELM_CONFIG_HOME=/workspace/.workshop/helm/config \
  -e HELM_DATA_HOME=/workspace/.workshop/helm/data \
  "$HELM_IMAGE" "$@"
