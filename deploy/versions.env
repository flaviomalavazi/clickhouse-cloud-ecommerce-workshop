# Pinned versions of the platform tools, one KEY=value per line. Read by the
# deploy/bin wrappers (sh) and by the Makefile (include), so nothing here may be
# quoted or contain a space.
#
# The tools run from these images, so participants install none of them. The
# cluster's Kubernetes version is set in deploy/k3d/cluster.yaml.
K3D_IMAGE=ghcr.io/k3d-io/k3d:5.8.3
HELM_IMAGE=alpine/helm:3.19.0
KUBECTL_IMAGE=registry.k8s.io/kubectl:v1.33.9

# k3d starts two helper containers; without these they would be `latest`.
K3D_TOOLS_IMAGE=ghcr.io/k3d-io/k3d-tools:5.8.3
K3D_PROXY_IMAGE=ghcr.io/k3d-io/k3d-proxy:5.8.3

# The Kubernetes collectors (deploy/helm/otel-k8s). The ClickStack guide pins the
# image to 0.123.0 and leaves the chart unpinned; 0.122.5 is the last chart built
# for that collector generation (appVersion 0.123.1), so the chart's presets and
# the image agree.
OTEL_CHART_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts
OTEL_CHART_VERSION=0.122.5

# Third-party images the workloads run are pinned where they are used: Snowplow
# Micro in deploy/helm/clickshop/values.yaml, the collector (0.123.0, the version
# the ClickStack guide pins) in deploy/helm/otel-k8s/*.values.yaml.
