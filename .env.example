# ClickShop workshop configuration. This is the ONLY config file: copy it to
# `.env` (gitignored) and fill in the required block. Every command and every
# pod reads it, so you never edit another file to configure the workshop.
#
# Format rules (the file is read as-is by `docker run --env-file` and by
# `kubectl create secret --from-env-file`):
#   - one KEY=value per line, no quotes around values
#   - comments on their own line, never after a value

# ── Required: fill these in (module 01) ──────────────────────────────────────
# ClickHouse Cloud service host: no scheme, no port.
# Example: abc123.us-east-1.aws.clickhouse.cloud
CLICKHOUSE_HOST=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Managed Postgres *direct* endpoint, not the pooler (the CDC ClickPipe needs
# a direct connection).
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=clickshop

# ── Optional: the defaults work; change only if a module tells you to ────────
# CLICKHOUSE_PORT=8443
# PRODUCE_TARGET_EPS=200
# CC_TARGET_TPS=20
# SIM_MAX_BACKLOG=4
# SIM_ARRIVALS_PER_MINUTE=6
# CARD_GATEWAY_DOWN=false
# Seed for the deterministic Postgres seed (prices, stock, customers, orders).
# SEED_RANDOM_SEED=42
# Recommended: verify the Managed Postgres server certificate. Download the
# instance's CA certificate from the Cloud console into assets/certs/ (*.pem
# files are gitignored) and point at it, relative to the repo root. The
# connection then uses verify-full (certificate chain and hostname). Without
# it the connection is encrypted but the server is not authenticated.
# PGSSLROOTCERT=assets/certs/ca-certificate.pem
# TLS is on by default for any host that is not localhost. These two exist for
# local test databases.
# PGSSLMODE=require
# CLICKHOUSE_SECURE=true
