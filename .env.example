# INTERIM TEMPLATE. Phase 1 removed every block that belonged to a deleted
# component. Phase 5.4 replaces this file with the workshop's single root .env
# layout (required block + optional block, D21). Copy to `.env` — the only
# config file anyone fills in.
#
# ── PostgreSQL (ClickHouse Managed Postgres) ──────────────────────────────────
# Use the *direct* endpoint, never a pooler: CDC needs a direct connection.
PGHOST=<host>.clickhouse.cloud
PGPORT=5432
PGUSER=retail_user
PGPASSWORD=<password>
PGDATABASE=retail_db

# TLS mode for the Python clients. Normally leave unset: they require TLS for
# any remote PGHOST — ClickHouse Cloud answers a plaintext connection with
# "FATAL: SSL required". Set this only to override that, e.g. `verify-full`
# with PGSSLROOTCERT to pin the CA.
# PGSSLMODE=require

# ── ClickHouse Cloud (frontend: search, analytics, recommendations) ───────────
CLICKHOUSE_URL=https://<host>.clickhouse.cloud:8443
CLICKHOUSE_DATABASE=retail_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<password>

# ── OTel Collector → ClickHouse ───────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_AUTH_HEADER=
OTEL_CLICKHOUSE_ENDPOINT=https://<host>.clickhouse.cloud:8443
OTEL_CLICKHOUSE_USER=default
OTEL_CLICKHOUSE_PASSWORD=<password>
OTEL_CLICKHOUSE_DATABASE=retail_otel
# NOTE: In cloud mode the database must already exist — CREATE DATABASE is skipped.

# ClickHouse exporter insert timeout (image default: 5s). Against Cloud the
# metrics batches routinely blow past 5s and are dropped after retrying, so the
# cloud setup wants this raised.
OTEL_EXPORTER_TIMEOUT=30s

# ── HyperDX → ClickHouse connection shown in UI ───────────────────────────────
# HYPERDX_CLICKHOUSE_URL=https://<host>.clickhouse.cloud:8443

# ── Snowplow ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SNOWPLOW_COLLECTOR_URL=http://localhost:9090
NEXT_PUBLIC_SNOWPLOW_APP_ID=clickshop

# ── Next.js ───────────────────────────────────────────────────────────────────
# Baked into the Next.js build — must match the URL the browser uses.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── HyperDX browser SDK ───────────────────────────────────────────────────────
# URL the *browser* uses to reach the OTel collector.
NEXT_PUBLIC_OTEL_COLLECTOR_URL=http://localhost:4318

# ── Demo service graph ───────────────────────────────────────────────────────
# Set to true to make the card gateway fail (the observability exercise).
CARD_GATEWAY_DOWN=false
CARD_GATEWAY_TIMEOUT_MS=900

# ── Seed ──────────────────────────────────────────────────────────────────────
SEED_RANDOM_SEED=42
