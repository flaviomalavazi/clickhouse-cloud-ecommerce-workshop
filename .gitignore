# ── Environment / secrets ─────────────────────────────────────────────────────
# Never commit actual credentials — use .env.example as the template.
.env
.env.local
.env.*.local
.env.cloud
.env.cloud.*
.deploy.env
frontend/.env.local
frontend/.env.*.local
data-generators/.env
*.pem

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/
frontend/tsconfig.tsbuildinfo
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
# Source JPEGs for the catalogue (~437 MB). Only the converted WebPs under
# frontend/public/images/ are committed.
assets/product_images/
.clickhouse/

# ── Local-only reference material ─────────────────────────────────────────────
# The implementation plan and other working documents. Never committed.
base_contents/
# The decisions log: the long working record of why things are the way they are. Kept on the owner's machine, not published.
docs/decisions.md

# ── Workshop agent mode ───────────────────────────────────────────────────────
# Per-participant progress file written by the guide agent (AGENTS.md).
.workshop/

# ── Claude Code ───────────────────────────────────────────────────────────────
# Per-machine permissions and tokens; the shared /workshop command in .claude/commands/ is committed.
.claude/settings.local.json
